# Make AI SDKs accessible to workspace packages that depend on @novastorm-ai/core
# These are marked as external in CLI's tsup config but need to be resolvable at runtime
public-hoist-pattern[]=@anthropic-ai/*
public-hoist-pattern[]=openai
public-hoist-pattern[]=zod
public-hoist-pattern[]=picomatch
public-hoist-pattern[]=ws
public-hoist-pattern[]=http-proxy
public-hoist-pattern[]=html2canvas
public-hoist-pattern[]=node-fetch
public-hoist-pattern[]=whatwg-url
