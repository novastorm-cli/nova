{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "lint": {
      "inputs": ["**/*.ts"]
    },
    "format-check": {
      "inputs": ["**/*.ts"]
    }
  }
}
