{
  "name": "nova-architect",
  "version": "0.0.1",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "turbo run build",
    "test": "vitest run",
    "lint": "turbo run lint",
    "format-check": "prettier --check \"packages/*/src/**/*.ts\"",
    "format-write": "prettier --write \"packages/*/src/**/*.ts\"",
    "link": "rm -rf .turbo packages/*/.turbo packages/*/dist && pnpm build && cd packages/cli && pnpm link --global",
    "eval": "turbo run eval --filter=@novastorm-ai/eval"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^25.5.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "globals": "^17.6.0",
    "jsdom": "^29.0.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "tsup": "^8.4.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.3",
    "vitest": "^3.0.0",
    "ws": "^8.19.0"
  }
}
